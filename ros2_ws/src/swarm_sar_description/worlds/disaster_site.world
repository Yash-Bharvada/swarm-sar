<?xml version="1.0"?>
<sdf version="1.9">
  <world name="disaster_site">
    <physics name="vm_stable" type="ignored"><max_step_size>0.004</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <scene><ambient>0.10 0.10 0.12 1</ambient><background>0.015 0.018 0.025 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional"><pose>0 0 18 0 0 0</pose><diffuse>0.75 0.70 0.62 1</diffuse><specular>0.25 0.25 0.25 1</specular><direction>-0.5 0.2 -0.84</direction><cast_shadows>true</cast_shadows></light>

    <model name="floor"><static>true</static><pose>0 0 -0.1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>40 40 0.2</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision><visual name="visual"><geometry><box><size>40 40 0.2</size></box></geometry><material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.28 0.28 0.29 1</diffuse></material></visual></link></model>

    <!-- Boundary walls and a deliberately broken interior floor plan. -->
    <model name="boundary"><static>true</static><link name="walls">
      <collision name="north_c"><pose>0 20 1.5 0 0 0</pose><geometry><box><size>40 0.35 3</size></box></geometry></collision><visual name="north_v"><pose>0 20 1.5 0 0 0</pose><geometry><box><size>40 0.35 3</size></box></geometry></visual>
      <collision name="south_c"><pose>0 -20 1.5 0 0 0</pose><geometry><box><size>40 0.35 3</size></box></geometry></collision><visual name="south_v"><pose>0 -20 1.5 0 0 0</pose><geometry><box><size>40 0.35 3</size></box></geometry></visual>
      <collision name="east_c"><pose>20 0 1.5 0 0 0</pose><geometry><box><size>0.35 40 3</size></box></geometry></collision><visual name="east_v"><pose>20 0 1.5 0 0 0</pose><geometry><box><size>0.35 40 3</size></box></geometry></visual>
      <collision name="west_c"><pose>-20 0 1.5 0 0 0</pose><geometry><box><size>0.35 40 3</size></box></geometry></collision><visual name="west_v"><pose>-20 0 1.5 0 0 0</pose><geometry><box><size>0.35 40 3</size></box></geometry></visual>
    </link></model>

    <model name="damaged_walls"><static>true</static><link name="link">
      <collision name="a_c"><pose>-8 2 1.3 0 0 0</pose><geometry><box><size>0.35 22 2.6</size></box></geometry></collision><visual name="a_v"><pose>-8 2 1.3 0 0 0</pose><geometry><box><size>0.35 22 2.6</size></box></geometry><material><diffuse>0.35 0.33 0.30 1</diffuse></material></visual>
      <collision name="b_c"><pose>5 9 1.3 0 0 0</pose><geometry><box><size>18 0.35 2.6</size></box></geometry></collision><visual name="b_v"><pose>5 9 1.3 0 0 0</pose><geometry><box><size>18 0.35 2.6</size></box></geometry></visual>
      <collision name="c_c"><pose>7 -5 1.3 0 0 0.35</pose><geometry><box><size>0.35 18 2.6</size></box></geometry></collision><visual name="c_v"><pose>7 -5 1.3 0 0 0.35</pose><geometry><box><size>0.35 18 2.6</size></box></geometry></visual>
      <collision name="d_c"><pose>-1 -9 1.3 0 0 0</pose><geometry><box><size>13 0.35 2.6</size></box></geometry></collision><visual name="d_v"><pose>-1 -9 1.3 0 0 0</pose><geometry><box><size>13 0.35 2.6</size></box></geometry></visual>
      <collision name="e_c"><pose>13 2 1.3 0 0 0</pose><geometry><box><size>11 0.35 2.6</size></box></geometry></collision><visual name="e_v"><pose>13 2 1.3 0 0 0</pose><geometry><box><size>11 0.35 2.6</size></box></geometry></visual>
    </link></model>

    <!-- Rubble uses primitive collision geometry so physics stays stable in VMs. -->
    <model name="rubble_north"><static>true</static><pose>-3 12 0.45 0.15 0.25 0.4</pose><link name="link"><collision name="c"><geometry><box><size>4.5 2.4 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>4.5 2.4 0.8</size></box></geometry><material><diffuse>0.29 0.25 0.21 1</diffuse></material></visual></link></model>
    <model name="rubble_center"><static>true</static><pose>0 1 0.6 -0.2 0.15 -0.3</pose><link name="link"><collision name="c"><geometry><box><size>5 3 1.1</size></box></geometry></collision><visual name="v"><geometry><box><size>5 3 1.1</size></box></geometry><material><diffuse>0.33 0.29 0.25 1</diffuse></material></visual></link></model>
    <model name="slab"><static>true</static><pose>11 -10 1.1 0.1 0.65 0.2</pose><link name="link"><collision name="c"><geometry><box><size>7 2.2 0.35</size></box></geometry></collision><visual name="v"><geometry><box><size>7 2.2 0.35</size></box></geometry><material><diffuse>0.42 0.40 0.38 1</diffuse></material></visual></link></model>

    <light name="warning_west" type="point"><pose>-10 -4 2.0 0 0 0</pose><diffuse>1 0.28 0.02 1</diffuse><attenuation><range>7</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.02</quadratic></attenuation></light>
    <light name="warning_east" type="point"><pose>10 6 2.0 0 0 0</pose><diffuse>1 0.28 0.02 1</diffuse><attenuation><range>7</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.02</quadratic></attenuation></light>

    <!-- Survivor poses are mirrored in survivor_oracle launch parameters. -->
    <model name="survivor_0"><static>true</static><pose>-14 13 0.45 1.57 0 0.4</pose><link name="body"><visual name="v"><geometry><capsule><radius>0.22</radius><length>1.25</length></capsule></geometry><material><diffuse>0.75 0.18 0.10 1</diffuse><emissive>0.18 0.03 0.01 1</emissive></material></visual></link></model>
    <model name="survivor_1"><static>true</static><pose>-2 6 0.45 1.57 0 -0.5</pose><link name="body"><visual name="v"><geometry><capsule><radius>0.22</radius><length>1.25</length></capsule></geometry><material><diffuse>0.75 0.18 0.10 1</diffuse></material></visual></link></model>
    <model name="survivor_2"><static>true</static><pose>14 14 0.45 1.57 0 0.2</pose><link name="body"><visual name="v"><geometry><capsule><radius>0.22</radius><length>1.25</length></capsule></geometry><material><diffuse>0.75 0.18 0.10 1</diffuse></material></visual></link></model>
    <model name="survivor_3"><static>true</static><pose>13 -14 0.45 1.57 0 -0.8</pose><link name="body"><visual name="v"><geometry><capsule><radius>0.22</radius><length>1.25</length></capsule></geometry><material><diffuse>0.75 0.18 0.10 1</diffuse></material></visual></link></model>
    <model name="survivor_4"><static>true</static><pose>-13 -12 0.45 1.57 0 0.6</pose><link name="body"><visual name="v"><geometry><capsule><radius>0.22</radius><length>1.25</length></capsule></geometry><material><diffuse>0.75 0.18 0.10 1</diffuse></material></visual></link></model>
  </world>
</sdf>
