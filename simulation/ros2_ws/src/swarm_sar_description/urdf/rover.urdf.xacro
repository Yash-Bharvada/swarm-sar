<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg robot_name)">
  <xacro:arg name="robot_name" default="rover_0"/>
  <xacro:arg name="low_resource" default="true"/>
  <xacro:arg name="slam_mode" default="false"/>
  <xacro:property name="slam_mode" value="$(arg slam_mode)"/>
  <xacro:property name="lite" value="$(arg low_resource)"/>
  <xacro:property name="robot_name" value="$(arg robot_name)"/>
  <xacro:property name="wheel_radius" value="0.14"/>
  <xacro:property name="wheel_width" value="0.08"/>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.24"/>
  </joint>
  <link name="base_link">
    <inertial><origin xyz="0 0 0"/><mass value="15.0"/><inertia ixx="0.40" ixy="0" ixz="0" iyy="0.65" iyz="0" izz="0.78"/></inertial>
    <visual><geometry><box size="0.72 0.52 0.22"/></geometry><material name="rescue_yellow"><color rgba="0.95 0.55 0.05 1"/></material></visual>
    <collision><geometry><box size="0.72 0.52 0.22"/></geometry></collision>
  </link>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_wheel_link">
      <inertial><mass value="0.65"/><inertia ixx="0.00353" ixy="0" ixz="0" iyy="0.00637" iyz="0" izz="0.00353"/></inertial>
      <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="tire"><color rgba="0.06 0.06 0.06 1"/></material></visual>
      <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} -0.10"/><axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.1"/>
    </joint>
    <gazebo reference="${name}_wheel_link"><mu1>0.9</mu1><mu2>0.15</mu2><fdir1>1 0 0</fdir1></gazebo>
  </xacro:macro>
  <xacro:wheel name="front_left" x="0.25" y="0.30"/>
  <xacro:wheel name="rear_left" x="-0.25" y="0.30"/>
  <xacro:wheel name="front_right" x="0.25" y="-0.30"/>
  <xacro:wheel name="rear_right" x="-0.25" y="-0.30"/>

  <link name="lidar_link">
    <inertial><mass value="0.12"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual><geometry><cylinder radius="0.06" length="0.08"/></geometry></visual>
    <collision><geometry><cylinder radius="0.06" length="0.08"/></geometry></collision>
  </link>
  <joint name="lidar_joint" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0.18 0 0.18"/></joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <frame_id>${robot_name}/lidar_link</frame_id>
      <topic>/${robot_name}/scan</topic><update_rate>${5 if lite else 10}</update_rate><always_on>true</always_on><visualize>false</visualize>
      <lidar><scan><horizontal><samples>${180 if lite else 720}</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.12</min><max>12.0</max><resolution>0.02</resolution></range></lidar>
    </sensor>
    <sensor name="imu" type="imu"><frame_id>${robot_name}/lidar_link</frame_id><topic>/${robot_name}/imu/data</topic><update_rate>50</update_rate><always_on>true</always_on></sensor>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint><left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint><right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.60</wheel_separation><wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_velocity>0.8</max_linear_velocity><min_linear_velocity>-0.4</min_linear_velocity>
      <max_angular_velocity>0.7</max_angular_velocity><min_angular_velocity>-0.7</min_angular_velocity>
      <max_linear_acceleration>0.4</max_linear_acceleration><min_linear_acceleration>-0.6</min_linear_acceleration>
      <max_angular_acceleration>0.6</max_angular_acceleration><min_angular_acceleration>-0.6</min_angular_acceleration>
      <topic>/${robot_name}/cmd_vel</topic><odom_topic>/${robot_name}/wheel_odom</odom_topic><tf_topic>/${robot_name}/wheel_tf</tf_topic>
      <frame_id>${robot_name}/odom</frame_id><child_frame_id>${robot_name}/base_footprint</child_frame_id><odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <!-- World pose closes the simulation path loop without skid-steer odometry drift. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_topic>/${robot_name}/odom</odom_topic><tf_topic>/${robot_name}/tf</tf_topic>
      <odom_frame>${'map' if slam_mode else robot_name+'/odom'}</odom_frame><robot_base_frame>${robot_name+'/ground_truth_base' if slam_mode else robot_name+'/base_footprint'}</robot_base_frame>
      <dimensions>3</dimensions><odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"><topic>/${robot_name}/joint_states</topic><update_rate>20</update_rate></plugin>
  </gazebo>
</robot>
